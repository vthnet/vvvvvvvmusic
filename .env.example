# VTH MUSIC Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (from BotFather)
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Telegram API credentials (from my.telegram.org)
API_ID=PUT_API_ID_HERE
API_HASH=PUT_API_HASH_HERE

# MongoDB database URI
MONGO_URI=PUT_MONGO_URI_HERE

# Bot owner user ID (your Telegram user ID)
OWNER_ID=PUT_OWNER_ID_HERE

# Pyrogram user session string (for voice chat access)
# Generate with: python -m pyrogram create_session
STRING_SESSION=PUT_ASSISTANT_SESSION_HERE

# Optional: Genius API key for lyrics
GENIUS_API_KEY=

